---
// Homepage for the broader Diversio Engineering hub.
//
// Why this page exists:
// - `/` should now explain the whole engineering site, not just the tools repo
// - the tools catalog moved to `/agentic-tools`
// - the homepage should help visitors choose between how-we-work content, systems notes, tools, and writing
//
// Keep this page high-level.
// Detailed install flows, package docs, and skill docs belong deeper in the site.
import PageLayout from "../layouts/PageLayout.astro";
import SectionHeader from "../components/SectionHeader.astro";
import Card from "../components/Card.astro";
import CardGrid from "../components/CardGrid.astro";
import { formatEditorialDate } from "../utils/format-date";
import { getAuthorHref } from "../utils/authors";
import { pickFeaturedBlogPost } from "../utils/pick-featured-blog-post";
import { getPublishedBlogPosts } from "../utils/blog-posts";
import { getSiteMetrics } from "../utils/site-metrics";
import { homepageFeaturedPluginSlugs } from "../data/agentic-tools";
import { plugins } from "../data/marketplace.json";
import { openSourceProjects } from "../data/open-source-projects";
import { internshipExampleCount, internshipProgramSnapshot } from "../data/internship-stories";
import { siteEntryPoints } from "../data/site-entry-points";
import { getMarketplaceItemsBySlug } from "../utils/marketplace-content";
import { siteConfig } from "../../site.config.mjs";

const featuredTools = getMarketplaceItemsBySlug(plugins, homepageFeaturedPluginSlugs);
const publishedPosts = await getPublishedBlogPosts();
const metrics = await getSiteMetrics(publishedPosts);
const summaryWritingValue = publishedPosts.length > 0 ? String(metrics.publishedPostCount) : String(metrics.systemsHighlightCount);
const summaryWritingLabel = publishedPosts.length > 0 ? "Engineering articles" : "Systems guides";
const writingMeta = publishedPosts.length === 0
  ? "No published posts yet"
  : metrics.originalPostCount > 0 && metrics.repostCount > 0
    ? `${metrics.originalPostCount} original · ${metrics.repostCount} repost${metrics.repostCount === 1 ? "" : "s"}`
    : metrics.originalPostCount > 0
      ? `${metrics.originalPostCount} original post${metrics.originalPostCount === 1 ? "" : "s"}`
      : `${metrics.repostCount} curated repost${metrics.repostCount === 1 ? "" : "s"}`;
const featuredWritingPost = pickFeaturedBlogPost(publishedPosts);
const homeTopicLabels = [
  "Team habits",
  "Systems notes",
  "Open tools",
  "Writing",
  "Internships",
] as const;
const homeProofCards = [
  {
    value: String(metrics.totalSkills),
    label: "AI workflows",
    description: "Reusable instructions for code reviews, releases, API documentation, and more.",
    href: "/skills/",
  },
  {
    value: String(metrics.piPackageCount),
    label: "AI terminal add-ons",
    description: "Extend Pi, a terminal-based coding assistant, with CI checks, image routing, and development workflows.",
    href: "/pi/",
  },
  {
    value: String(openSourceProjects.length),
    label: "Standalone tools",
    description: "Run checks locally, organize agent terminals, or connect external services.",
    href: "#open-source-projects",
  },
  {
    value: summaryWritingValue,
    label: summaryWritingLabel,
    description: publishedPosts.length > 0
      ? "Original writing and selected articles on how software gets built."
      : "Explore the architecture and technology behind our products.",
    href: publishedPosts.length > 0 ? siteConfig.routes.blog : siteConfig.routes.systems,
  },
] as const;
const homePathCards = [
  {
    label: siteEntryPoints.howWeWork.label,
    title: siteEntryPoints.howWeWork.title,
    description: siteEntryPoints.howWeWork.description,
    href: siteEntryPoints.howWeWork.href,
    cta: siteEntryPoints.howWeWork.cta,
    meta: "standards · habits",
    featured: true,
  },
  {
    label: siteEntryPoints.systems.label,
    title: siteEntryPoints.systems.title,
    description: siteEntryPoints.systems.description,
    href: siteEntryPoints.systems.href,
    cta: siteEntryPoints.systems.cta,
    meta: `${metrics.stackLayerCount} stack layers`,
  },
  {
    label: siteEntryPoints.tools.label,
    title: siteEntryPoints.tools.title,
    description: siteEntryPoints.tools.description,
    href: siteEntryPoints.tools.href,
    cta: siteEntryPoints.tools.cta,
    meta: `${metrics.totalSkills} AI workflows · ${metrics.piPackageCount} Pi add-ons`,
  },
  {
    label: "Internships",
    title: "See what interns actually ship",
    description: "Representative work across product features, internal tooling, and systems the team still uses.",
    href: siteConfig.routes.internships,
    cta: "See internship work",
    meta: `${internshipExampleCount} examples · ${internshipProgramSnapshot.shippedChangesLabel}`,
  },
  {
    label: siteEntryPoints.blog.label,
    title: siteEntryPoints.blog.title,
    description: siteEntryPoints.blog.description,
    href: siteEntryPoints.blog.href,
    cta: siteEntryPoints.blog.cta,
    meta: writingMeta,
  },
] as const;
function getPostSlug(post: { id: string; data: { slug?: string } }) {
  return (post.data.slug ?? post.id).replace(/\.md$/, "");
}
---

<PageLayout
  title={siteConfig.siteName}
  description={siteConfig.defaultDescription}
  ogImage="/og/home.png"
  socialImageAlt="Diversio Engineering social preview"
  currentNav="home"
>
  <section class="home-hero schematic-grid">
    <div class="home-hero-shell">
      <div class="home-hero-copy-card">
        <span class="label-caps home-kicker">{siteConfig.siteName}</span>
        <h1 class="home-title">Engineering systems, open tools, and the way we work</h1>
        <p class="body-lg home-desc">
          We publish working habits, systems notes, open-source tools, internship work, and writing from the team. If you want to understand how Diversio Engineering builds, this is the front door.
        </p>
        <div class="home-actions">
          <a href={siteConfig.routes.howWeWork} class="btn btn-primary btn-md">Start with How We Work</a>
          <a href={siteConfig.routes.systems} class="btn btn-secondary btn-md">Explore Systems</a>
          <a href={siteConfig.githubUrl} class="btn btn-secondary btn-md" target="_blank" rel="noopener noreferrer" aria-label="DiversioTeam on GitHub">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z" />
            </svg>
            GitHub
          </a>
        </div>
        <div class="home-topic-list" aria-label="Site topics">
          {homeTopicLabels.map((homeTopicLabel) => (
            <span class="home-topic-chip">{homeTopicLabel}</span>
          ))}
        </div>
      </div>

      <aside class="home-proof-card" aria-labelledby="home-resources-title">
        <div>
          <h2 id="home-resources-title" class="headline-sm">Tools to use. Ideas to borrow.</h2>
          <p class="body-md home-proof-note">Explore our open-source tools, reusable AI workflows, and engineering notes.</p>
        </div>
        <div class="home-proof-grid">
          {homeProofCards.map((homeProofCard) => (
            <a href={homeProofCard.href} class="home-proof-item">
              <span class="home-proof-value">{homeProofCard.value}</span>
              <h3 class="home-proof-label">{homeProofCard.label}</h3>
              <p class="home-proof-description">{homeProofCard.description}</p>
              <span class="home-proof-link" aria-hidden="true">Explore →</span>
            </a>
          ))}
        </div>
      </aside>
    </div>
  </section>

  <section class="page-section">
    <SectionHeader
      label="Start here"
      title="Pick the path that matches what you want"
      description="Some visitors want team habits. Some want systems. Some want tools. Some want to see the writing or the internship work."
      variant="hub"
    />
    <div class="home-path-grid">
      {homePathCards.map((homePathCard) => (
        <a href={homePathCard.href} class={`home-path-card${homePathCard.featured ? " home-path-card--featured" : ""}`}>
          <div class="home-path-header">
            <span class="label-caps">{homePathCard.label}</span>
            <span class="code-text-sm home-path-meta">{homePathCard.meta}</span>
          </div>
          <h3 class="headline-sm home-path-title">{homePathCard.title}</h3>
          <p class="body-md home-path-description">{homePathCard.description}</p>
          <span class="label-caps home-path-link">{homePathCard.cta} →</span>
        </a>
      ))}
    </div>
  </section>

  {featuredWritingPost && (
    <section class="page-section">
      <SectionHeader
        label="Featured Writing"
        title="From the blog"
        description="One highlighted article from Diversio Engineering."
        variant="blog"
      />
      <article class="latest-post-card">
        <div class="latest-post-meta">
          <span class={`label-caps latest-post-kind${featuredWritingPost.data.sourceType === "repost" ? " latest-post-kind--repost" : ""}`}>
            {featuredWritingPost.data.sourceType === "repost" ? "Curated repost" : "Original post"}
          </span>
          <span class="code-text-sm latest-post-date">{formatEditorialDate(featuredWritingPost.data.publishDate, "short")}</span>
        </div>
        <div class="latest-post-body">
          <div class="latest-post-copy">
            <h2 class="headline-md latest-post-title">
              <a href={`/blog/${getPostSlug(featuredWritingPost)}`}>{featuredWritingPost.data.title}</a>
            </h2>
            <p class="body-md latest-post-summary">{featuredWritingPost.data.summary}</p>
            <div class="latest-post-footer body-md">
              <a href={getAuthorHref(featuredWritingPost.data.author.name)} class="latest-post-author-link">{featuredWritingPost.data.author.name}</a>
              <span aria-hidden="true">·</span>
              <span>{featuredWritingPost.data.sourceType === "repost" ? "Curated repost" : "Original post"}</span>
            </div>
          </div>
          <div class="latest-post-actions">
            <a href={`/blog/${getPostSlug(featuredWritingPost)}`} class="btn btn-primary btn-md">Read the article</a>
          </div>
        </div>
      </article>
    </section>
  )}

  <section class="page-section">
    <div class="catalog-header">
      <SectionHeader
        label={siteConfig.toolsSectionName}
        title="Featured tools"
        description="Featured projects from Agentic Tools."
        variant="tools"
      />
      <a href={siteConfig.routes.registry} class="catalog-view-all label-caps">View full registry →</a>
    </div>
    <CardGrid cols={3}>
      {featuredTools.map((tool) => (
        <Card
          category={tool.category}
          packageId={tool.name}
          title={tool.title}
          description={tool.description}
          version={tool.version}
          runtimes={["CC", "CODEX"]}
          href={`/docs/${tool.name}`}
        />
      ))}
    </CardGrid>
  </section>

  <section id="open-source-projects" class="page-section page-section--top-border">
    <SectionHeader
      label="Open Source"
      title="More open source projects"
      description="A small curated set of open source repos from Diversio Engineering beyond the Agentic Tools registry."
      variant="hub"
    />
    <div class="project-grid">
      {openSourceProjects.map((project) => (
        <a href={project.url} class="project-card" target="_blank" rel="noopener">
          <div class="project-card-header">
            <span class="label-caps project-category">{project.category}</span>
            <span class="code-text-sm project-repo">{project.repo}</span>
          </div>
          <div class="project-card-body">
            <h3 class="headline-sm project-title">{project.name}</h3>
            <p class="body-md project-copy">{project.description}</p>
            <span class="label-caps project-link">Open on GitHub →</span>
          </div>
        </a>
      ))}
    </div>
  </section>
</PageLayout>

<style>
  .home-hero,
  .page-section {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: var(--space-3xl) var(--space-margin);
  }

  .page-section + .page-section {
    border-top: var(--border-hairline);
  }

  .home-hero {
    position: relative;
    overflow: hidden;
  }

  .home-hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at top right, color-mix(in srgb, var(--color-primary-container) 60%, transparent), transparent 38%),
      linear-gradient(135deg, rgba(255, 255, 255, 0.84), rgba(255, 255, 255, 0.96));
    pointer-events: none;
  }

  .home-hero-shell,
  .home-path-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
  }

  .home-hero-copy-card,
  .home-proof-card,
  .home-path-card {
    background: var(--color-surface);
    border: var(--border-hairline);
    border-radius: 1rem;
    box-shadow: var(--shadow-block-sm);
  }

  .home-hero-copy-card,
  .home-proof-card,
  .home-path-card {
    padding: clamp(var(--space-lg), 2vw + 0.75rem, var(--space-2xl));
  }

  .home-hero-copy-card {
    display: grid;
    gap: var(--space-lg);
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.96), color-mix(in srgb, var(--color-primary-container) 18%, #ffffff));
  }

  .home-kicker,
  .home-topic-chip {
    color: var(--color-primary);
  }

  .home-title {
    font-family: var(--font-headline);
    font-size: clamp(2.6rem, 4vw, 4.75rem);
    font-weight: var(--weight-bold);
    line-height: 1.02;
    letter-spacing: var(--tracking-headline);
    color: var(--color-text);
    text-wrap: balance;
    max-width: 11ch;
  }

  .home-desc,
  .home-proof-note,
  .home-path-description {
    color: var(--color-text-secondary);
  }

  .home-desc {
    max-width: 45rem;
  }

  .home-actions,
  .home-topic-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    align-items: stretch;
  }

  .home-topic-chip {
    border: var(--border-hairline);
    border-radius: 999px;
    padding: 0.5rem 0.75rem;
    background: rgba(255, 255, 255, 0.92);
  }

  .home-proof-card {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-lg);
    background: linear-gradient(180deg, var(--color-surface), color-mix(in srgb, var(--color-primary-container) 14%, var(--color-surface)));
  }

  .home-path-header {
    display: flex;
    justify-content: space-between;
    align-items: start;
    gap: var(--space-sm);
  }

  .home-proof-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-sm);
  }

  .home-proof-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    text-decoration: none;
    padding: var(--space-md);
    border: var(--border-hairline);
    border-radius: 0.875rem;
    background: rgba(255, 255, 255, 0.88);
  }

  .home-proof-value {
    font-family: var(--font-headline);
    font-size: clamp(1.35rem, 1.05rem + 0.6vw, 2rem);
    font-weight: var(--weight-semibold);
    line-height: 1.05;
    color: var(--color-text);
  }

  .home-proof-label {
    margin: 0;
    color: var(--color-text);
    font-size: 1rem;
    line-height: 1.35;
  }

  .home-proof-description {
    margin: 0;
    color: var(--color-text-secondary);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .home-proof-link {
    margin-top: auto;
    color: var(--color-primary);
    font-size: 0.875rem;
  }

  .home-proof-item:hover,
  .home-proof-item:focus-visible {
    border-color: var(--color-primary);
    box-shadow: var(--shadow-block-sm);
  }

  .home-path-meta {
    color: var(--color-text-muted);
  }

  .home-proof-note {
    margin: 0;
  }

  .home-path-card {
    text-decoration: none;
    display: grid;
    gap: var(--space-sm);
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast), transform var(--transition-fast), background var(--transition-fast);
    height: 100%;
  }

  .home-path-card:hover,
  .home-path-card:focus-visible {
    border-color: var(--color-primary);
    box-shadow: var(--shadow-block);
    transform: translateY(-1px);
  }

  .home-path-card--featured {
    background: linear-gradient(180deg, var(--color-surface), color-mix(in srgb, var(--color-primary-container) 22%, var(--color-surface)));
  }

  .home-path-title {
    margin: 0;
    color: var(--color-text);
    text-wrap: balance;
  }

  .home-path-link {
    color: var(--color-primary);
    margin-top: auto;
  }

  @media (min-width: 900px) {
    .home-path-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .home-path-card--featured {
      grid-column: span 2;
    }
  }

  @media (min-width: 1200px) {
    .home-hero-shell {
      grid-template-columns: minmax(0, 1.15fr) minmax(22rem, 0.85fr);
      align-items: stretch;
    }

    .home-path-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .text-link,
  .catalog-view-all {
    color: var(--color-primary);
    text-decoration: none;
  }

  .text-link:hover,
  .catalog-view-all:hover {
    text-decoration: underline;
  }

  .latest-post-card {
    background: linear-gradient(180deg, var(--color-surface), var(--color-surface-low));
    border: var(--border-hairline);
    border-radius: 1.25rem;
    padding: clamp(var(--space-lg), 2vw + 0.75rem, var(--space-2xl));
    box-shadow: var(--shadow-block-sm);
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast), transform var(--transition-fast);
  }

  .latest-post-card:hover {
    border-color: var(--color-primary);
    box-shadow: var(--shadow-block);
    transform: translateY(-1px);
  }

  .latest-post-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-sm);
    flex-wrap: wrap;
    margin-bottom: var(--space-md);
  }

  .latest-post-kind {
    color: var(--color-primary);
    padding: 0.35rem 0.65rem;
    border: var(--border-hairline);
    border-radius: 999px;
    background: var(--color-primary-container);
  }

  .latest-post-kind--repost {
    color: var(--color-accent);
    background: var(--color-accent-container);
  }

  .latest-post-date {
    color: var(--color-text-muted);
  }

  .latest-post-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .latest-post-title {
    margin-bottom: var(--space-md);
    max-width: 18ch;
    text-wrap: balance;
  }

  .latest-post-title a {
    color: var(--color-text);
    text-decoration: none;
  }

  .latest-post-title a:hover {
    color: var(--color-primary);
  }

  .latest-post-summary,
  .latest-post-footer {
    color: var(--color-text-secondary);
  }

  .latest-post-author-link {
    color: var(--color-text-secondary);
    text-decoration: none;
  }

  .latest-post-author-link:hover {
    color: var(--color-primary);
  }

  .catalog-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-md);
    flex-wrap: wrap;
    margin-bottom: var(--space-xl);
  }

  .page-section--top-border {
    border-top: var(--border-hairline);
  }

  .project-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);
  }

  @media (min-width: 700px) {
    .project-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1100px) {
    .project-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .project-card {
    background: var(--color-surface);
    border: var(--border-hairline);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-block-sm);
    text-decoration: none;
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast), transform var(--transition-fast);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .project-card:hover,
  .project-card:focus-visible {
    border-color: var(--color-primary);
    box-shadow: var(--shadow-block);
    transform: translateY(-1px);
  }

  .project-card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-sm);
    min-width: 0;
    padding: var(--space-xs) var(--space-md);
    background: var(--color-surface-low);
    border-bottom: var(--border-hairline);
  }

  .project-category {
    color: var(--color-text-secondary);
  }

  .project-repo {
    color: var(--color-text-muted);
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    text-align: right;
  }

  .project-card-body {
    padding: var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    height: 100%;
  }

  .project-title {
    color: var(--color-text);
  }

  .project-copy {
    color: var(--color-text-secondary);
  }

  .project-link {
    color: var(--color-primary);
    margin-top: auto;
  }

  @media (max-width: 860px) {
    .home-hero,
    .page-section {
      padding: var(--space-2xl) var(--space-md);
    }

    .home-title {
      max-width: none;
    }

    .home-actions > .btn,
    .latest-post-actions > .btn {
      width: 100%;
    }

    .home-proof-grid {
      grid-template-columns: 1fr;
    }

    .catalog-header,
    .latest-post-meta,
    .latest-post-footer,
    .home-path-header,
    .project-card-header {
      align-items: flex-start;
      flex-direction: column;
    }

    .project-repo {
      white-space: normal;
      text-align: left;
    }

    .latest-post-title {
      max-width: none;
    }
  }

  @media (min-width: 860px) {
    .latest-post-body {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
      gap: var(--space-xl);
    }
  }
</style>
