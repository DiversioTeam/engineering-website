---
import PageLayout from "../layouts/PageLayout.astro";
import SectionHeader from "../components/SectionHeader.astro";
import {
  internshipExampleCount,
  internshipProgramSnapshot,
  internshipStories,
  internshipWorkAreaLabels,
} from "../data/internship-stories";
import { siteConfig } from "../../site.config.mjs";

const internshipsPage = {
  title: "Internships at Diversio Engineering",
  metaDescription:
    "Interns at Diversio Engineering ship real product work, improve internal systems, and sometimes build tools the team keeps using after the internship ends.",
  heroTitle: "An internship with real engineering work",
  heroDescription:
    "Interns at Diversio Engineering ship product changes, improve internal systems, and sometimes build tooling the team still relies on after the internship ends. You join the team to do useful work, get serious feedback, and grow into bigger responsibilities over the term.",
} as const;

const heroTrackLabels = [...internshipWorkAreaLabels, "Shipped to production"] as const;
const heroProofCards = [
  {
    value: String(internshipExampleCount),
    label: "Examples on this page",
    detail: "One anchor case study plus three representative intern stories.",
  },
  {
    value: internshipProgramSnapshot.shippedChangesValue,
    label: "Production changes",
    detail: internshipProgramSnapshot.shippedChangesLabel,
  },
  {
    value: internshipProgramSnapshot.periodValue,
    label: "Recent cohorts",
    detail: internshipProgramSnapshot.periodLabel,
  },
  {
    value: `${internshipWorkAreaLabels.length} work areas`,
    label: "Product, platform, tooling",
    detail: internshipWorkAreaLabels.join(" · "),
  },
] as const;

const internshipFitCards = [
  {
    title: "Ownership and curiosity",
    description:
      "People tend to do well here when they want responsibility, ask how things work end to end, and stay eager to get involved in the day-to-day work.",
  },
  {
    title: "Pattern-finding and attention to detail",
    description:
      "We value people who notice small things, look for patterns others miss, stay calm under pressure, and dig past symptoms to the underlying system issue.",
  },
  {
    title: "Humility, learning, and long-term judgment",
    description:
      "Strong engineers here keep learning, apply what they learn, respect other people's ideas, help colleagues succeed, and make decisions that are good for Diversio and clients over the long run.",
  },
] as const;

const nabooStageCards = [
  {
    label: "The problem",
    title: "Too much workflow lived in people",
    description:
      "PR state, review state, CI, and releases kept drifting apart unless someone remembered the hidden rules and stitched the context together.",
  },
  {
    label: "What got built",
    title: "A GitHub-native workflow system",
    description:
      "Naboo reacts to pull request events, comments, review state, releases, and CI signals, then makes the right signal visible where engineers already work.",
  },
  {
    label: "Why it matters",
    title: "The team still uses it",
    description:
      "The team still uses it, which says more than any summary on this page. The work solved a real problem well enough to become part of daily engineering workflow.",
  },
] as const;

const internshipGrowthSteps = [
  {
    stepNumber: "01",
    title: "Learn the system fast",
    description:
      "You start by understanding the product, the workflow, and the people who rely on both. Context matters because the work is real.",
  },
  {
    stepNumber: "02",
    title: "Ship something concrete",
    description:
      "Early tasks are meant to be useful. They land, they get reviewed seriously, and they teach you how the team builds.",
  },
  {
    stepNumber: "03",
    title: "Move into deeper ownership",
    description:
      "Once you have the context and the trust, the work can expand into data flows, platform systems, notifications, tooling, and other consequential surfaces.",
  },
] as const;
---

<PageLayout
  title={internshipsPage.title}
  description={internshipsPage.metaDescription}
  ogImage="/og-default.png"
  socialImageAlt="Diversio Engineering internship work"
  currentNav="internships"
>
  <section class="internships-hero schematic-grid">
    <div class="hero-shell">
      <div class="hero-copy-card">
        <span class="label-caps hero-label">Internships</span>
        <h1 class="hero-title">{internshipsPage.heroTitle}</h1>
        <p class="body-lg hero-description">{internshipsPage.heroDescription}</p>

        <div class="hero-actions">
          <a href={siteConfig.routes.howWeWork} class="btn btn-primary btn-md">How we work</a>
          <a href={siteConfig.routes.systems} class="btn btn-secondary btn-md">See the systems</a>
        </div>

        <div class="hero-track-list" aria-label="Kinds of intern work">
          {heroTrackLabels.map((heroTrackLabel) => (
            <span class="hero-track">{heroTrackLabel}</span>
          ))}
        </div>
      </div>

      <aside class="hero-proof-card" aria-label="Internship proof points">
        <div class="hero-proof-header">
          <span class="label-caps">Concrete signals</span>
          <span class="code-text-sm">Diversio Engineering</span>
        </div>

        <div class="proof-grid">
          {heroProofCards.map((heroProofCard) => (
            <div class="proof-item">
              <span class="proof-value">{heroProofCard.value}</span>
              <span class="label-caps proof-label">{heroProofCard.label}</span>
              <p class="body-md proof-detail">{heroProofCard.detail}</p>
            </div>
          ))}
        </div>

        <p class="body-md proof-methodology">{internshipProgramSnapshot.methodology}</p>
      </aside>
    </div>
  </section>

  <section class="page-section">
    <SectionHeader
      label="Fit"
      title="What helps people do well here"
      description="These are the same qualities that help someone settle into the engineering team more broadly, not only during an internship."
      variant="editorial"
    />
    <div class="value-grid">
      {internshipFitCards.map((internshipFitCard) => (
        <article class="value-card">
          <span class="label-caps value-kicker">What tends to matter</span>
          <h2 class="headline-sm value-title">{internshipFitCard.title}</h2>
          <p class="body-md value-description">{internshipFitCard.description}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="page-section page-section--top-border">
    <div class="case-study-layout">
      <div class="case-study-copy">
        <SectionHeader
          label="Anchor example"
          title="Naboo started as intern work and became real engineering infrastructure"
          description="Naboo works well as an anchor example because it shows what happens when an intern finds a real problem, understands it end to end, and builds something the team keeps using."
          variant="editorial"
        />

        <div class="case-study-narrative-card">
          <p class="body-md">
            Naboo grew out of a very ordinary engineering problem: too much workflow knowledge was trapped in people. Someone had to remember what a pull request needed, whether CI had done the right thing, whether a merge was risky, and what signal the rest of the team actually needed.
          </p>
          <p class="body-md">
            The team needed software for that job. Naboo became a GitHub-native workflow service that reacts to pull request events, comments, releases, review state, and CI signals. It can explain CI, steer CI behavior, surface risky merges, and enrich release communication.
          </p>
          <p class="body-md case-study-callout">
            At its best, the internship looks like this: work that makes the whole team calmer, clearer, and harder to get wrong.
          </p>
        </div>
      </div>

      <div class="case-study-stage-list">
        {nabooStageCards.map((nabooStageCard, stageIndex) => (
          <article class={`case-study-stage case-study-stage--${stageIndex + 1}`}>
            <span class="label-caps case-study-stage-label">{nabooStageCard.label}</span>
            <h2 class="headline-sm case-study-stage-title">{nabooStageCard.title}</h2>
            <p class="body-md case-study-stage-description">{nabooStageCard.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="page-section page-section--top-border">
    <SectionHeader
      label="Representative work"
      title="What interns actually ship here"
      description="Different projects, different tools, same pattern: the work matters and someone has to trust you with it."
      variant="editorial"
    />

    <div class="stories-grid">
      {internshipStories.map((story) => (
        <article class="story-card">
          <div class="story-card-header">
            <span class="label-caps story-eyebrow">{story.eyebrow}</span>
            <span class="code-text-sm story-card-tag">Representative work</span>
          </div>

          <h2 class="headline-md story-title">{story.title}</h2>
          <p class="body-md story-summary">{story.summary}</p>

          <div class="story-tool-row" aria-label={`${story.title} tools`}>
            {story.tools.map((tool) => (
              <div class="story-tool">
                <img src={tool.logoSrc} alt={tool.logoAlt} class={`story-tool-logo${tool.wide ? " story-tool-logo--wide" : ""}`} loading="lazy" />
                <span class="code-text-sm story-tool-name">{tool.name}</span>
              </div>
            ))}
          </div>

          <p class="body-md story-tools-label"><strong>Worked with:</strong> {story.toolsLabel}</p>
          <p class="body-md story-detail">{story.detail}</p>

          <div class="story-outcomes-block">
            <span class="label-caps story-outcomes-label">What shipped</span>
            <ul class="story-outcomes">
              {story.outcomes.map((storyOutcome) => (
                <li class="body-md">{storyOutcome}</li>
              ))}
            </ul>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="page-section page-section--top-border">
    <SectionHeader
      label="How the internship grows"
      title="The work usually gets deeper over time"
      description="The common pattern is simple: learn fast, ship something useful, then take on broader ownership once you have earned the context and trust."
      variant="editorial"
    />

    <div class="growth-grid">
      {internshipGrowthSteps.map((internshipGrowthStep) => (
        <article class="growth-step-card">
          <span class="growth-step-number code-text">{internshipGrowthStep.stepNumber}</span>
          <h2 class="headline-sm growth-step-title">{internshipGrowthStep.title}</h2>
          <p class="body-md growth-step-description">{internshipGrowthStep.description}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="page-section page-section--top-border">
    <div class="closing-card">
      <div>
        <span class="label-caps closing-label">What to read next</span>
        <h2 class="headline-md closing-title">Want to understand the team behind the internship?</h2>
        <p class="body-md closing-description">
          The internship makes more sense once you see how the engineering team works, what kinds of systems it owns, and where the broader community work lives.
        </p>
      </div>

      <div class="closing-link-list">
        <a href={siteConfig.routes.howWeWork} class="closing-link">How we work →</a>
        <a href={siteConfig.routes.systems} class="closing-link">Systems →</a>
        <a href={siteConfig.routes.community} class="closing-link">Community →</a>
      </div>
    </div>
  </section>
</PageLayout>

<style>
  .internships-hero,
  .page-section {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: var(--space-3xl) var(--space-margin);
  }

  .internships-hero {
    position: relative;
    overflow: hidden;
  }

  .internships-hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at top right, color-mix(in srgb, var(--color-primary-container) 65%, transparent), transparent 38%),
      linear-gradient(135deg, rgba(255, 255, 255, 0.82), rgba(255, 255, 255, 0.96));
    pointer-events: none;
  }

  .page-section--top-border {
    border-top: var(--border-hairline);
  }

  .hero-shell,
  .case-study-layout,
  .value-grid,
  .stories-grid,
  .growth-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
  }

  .hero-copy-card,
  .hero-proof-card,
  .value-card,
  .case-study-narrative-card,
  .case-study-stage,
  .story-card,
  .growth-step-card,
  .closing-card {
    background: var(--color-surface);
    border: var(--border-hairline);
    border-radius: 1rem;
    box-shadow: var(--shadow-block-sm);
  }

  .hero-copy-card,
  .hero-proof-card,
  .value-card,
  .case-study-narrative-card,
  .story-card,
  .growth-step-card {
    padding: clamp(var(--space-lg), 2vw + 0.75rem, var(--space-2xl));
  }

  .hero-copy-card {
    display: grid;
    gap: var(--space-lg);
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.96), color-mix(in srgb, var(--color-primary-container) 22%, #ffffff));
  }

  .hero-label,
  .hero-track,
  .proof-label,
  .value-kicker,
  .story-eyebrow,
  .story-outcomes-label,
  .closing-label {
    color: var(--color-primary);
  }

  .hero-title {
    font-family: var(--font-headline);
    font-size: clamp(2.35rem, 3vw + 1.35rem, 4.5rem);
    font-weight: var(--weight-bold);
    line-height: 1.02;
    letter-spacing: var(--tracking-headline);
    max-width: 12ch;
    text-wrap: balance;
  }

  .hero-description,
  .proof-methodology,
  .proof-detail,
  .value-description,
  .case-study-narrative-card p,
  .case-study-stage-description,
  .story-summary,
  .story-tools-label,
  .story-detail,
  .growth-step-description,
  .closing-description {
    color: var(--color-text-secondary);
  }

  .hero-description {
    max-width: 44rem;
  }

  .hero-actions,
  .hero-track-list,
  .story-tool-row,
  .closing-link-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .hero-track {
    border: var(--border-hairline);
    border-radius: 999px;
    padding: 0.5rem 0.75rem;
    background: rgba(255, 255, 255, 0.9);
  }

  .hero-proof-card {
    display: grid;
    gap: var(--space-lg);
    background: linear-gradient(180deg, var(--color-surface), color-mix(in srgb, var(--color-primary-container) 14%, var(--color-surface)));
  }

  .hero-proof-header,
  .story-card-header {
    display: flex;
    justify-content: space-between;
    align-items: start;
    gap: var(--space-sm);
  }

  .proof-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-sm);
  }

  .proof-item {
    display: grid;
    gap: var(--space-xs);
    min-width: 0;
    padding: var(--space-md);
    border: var(--border-hairline);
    border-radius: 0.875rem;
    background: rgba(255, 255, 255, 0.88);
    align-content: start;
  }

  .proof-value {
    font-family: var(--font-headline);
    font-size: clamp(1.35rem, 1.05rem + 0.6vw, 2rem);
    font-weight: var(--weight-semibold);
    line-height: 1.08;
    color: var(--color-text);
    text-wrap: balance;
  }

  .proof-label,
  .story-card-tag {
    color: var(--color-text-muted);
  }

  .proof-detail {
    margin: 0;
  }

  @media (min-width: 1100px) {
    .hero-shell {
      grid-template-columns: minmax(0, 1.15fr) minmax(22rem, 0.85fr);
      align-items: stretch;
    }
  }

  .value-grid {
    grid-template-columns: 1fr;
  }

  .value-card {
    display: grid;
    gap: var(--space-sm);
    background: linear-gradient(180deg, var(--color-surface), var(--color-surface-low));
  }

  .value-title,
  .case-study-stage-title,
  .story-title,
  .growth-step-title,
  .closing-title {
    text-wrap: balance;
  }

  .case-study-copy {
    display: grid;
    gap: var(--space-lg);
  }

  .case-study-narrative-card {
    display: grid;
    gap: var(--space-md);
  }

  .case-study-callout {
    padding-top: var(--space-sm);
    border-top: var(--border-hairline);
    font-weight: var(--weight-semibold);
    color: var(--color-text);
  }

  .case-study-stage-list {
    display: grid;
    gap: var(--space-md);
  }

  .case-study-stage {
    display: grid;
    gap: var(--space-sm);
    padding: var(--space-lg);
  }

  .case-study-stage--1 {
    background: color-mix(in srgb, var(--color-accent-container) 48%, var(--color-surface));
  }

  .case-study-stage--2 {
    background: color-mix(in srgb, var(--color-primary-container) 38%, var(--color-surface));
  }

  .case-study-stage--3 {
    background: color-mix(in srgb, #dff6e5 72%, var(--color-surface));
  }

  .case-study-stage-label,
  .growth-step-number {
    color: var(--color-text-muted);
  }

  .stories-grid {
    align-items: stretch;
  }

  .story-card {
    display: grid;
    gap: var(--space-md);
    height: 100%;
    background: linear-gradient(180deg, var(--color-surface), var(--color-surface-low));
  }

  .story-title {
    margin: 0;
  }

  .story-tool {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    min-width: 0;
    padding: 0.45rem 0.7rem;
    border: var(--border-hairline);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.86);
  }

  .story-tool-logo {
    width: 1rem;
    height: 1rem;
    object-fit: contain;
    flex-shrink: 0;
  }

  .story-tool-logo--wide {
    width: auto;
    max-width: 2rem;
    height: 1rem;
  }

  .story-tool-name {
    color: var(--color-text-secondary);
    white-space: nowrap;
  }

  .story-outcomes-block {
    display: grid;
    gap: var(--space-sm);
    margin-top: auto;
    padding-top: var(--space-sm);
    border-top: var(--border-hairline);
  }

  .story-outcomes {
    margin: 0;
    padding-left: 1.2rem;
  }

  .story-outcomes li + li {
    margin-top: var(--space-sm);
  }

  .growth-step-card {
    display: grid;
    gap: var(--space-sm);
  }

  .growth-step-number {
    font-size: 1rem;
  }

  .closing-card {
    display: grid;
    gap: var(--space-lg);
    padding: clamp(var(--space-lg), 2vw + 0.75rem, var(--space-2xl));
    background: linear-gradient(135deg, color-mix(in srgb, var(--color-primary-container) 45%, var(--color-surface)), var(--color-surface));
  }

  .closing-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-sm) var(--space-lg);
    border: var(--border-hairline);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.88);
    color: var(--color-text);
    font-family: var(--font-body);
    font-size: var(--text-label);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .closing-link:hover {
    color: var(--color-primary);
    border-color: var(--color-primary);
  }

  @media (min-width: 768px) {
    .value-grid,
    .growth-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 1120px) {
    .case-study-layout {
      grid-template-columns: minmax(0, 1.05fr) minmax(20rem, 0.95fr);
      align-items: start;
    }

    .stories-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .closing-card {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
    }

    .closing-link-list {
      justify-content: flex-end;
    }
  }

  @media (max-width: 860px) {
    .internships-hero,
    .page-section {
      padding: var(--space-2xl) var(--space-md);
    }

    .hero-title {
      max-width: none;
    }

    .hero-actions > .btn {
      width: 100%;
    }

    .proof-grid {
      grid-template-columns: 1fr;
    }

    .hero-proof-header,
    .story-card-header {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
